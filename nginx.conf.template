# 프론트엔드 정적 파일과 백엔드 프록시를 한 origin 에서 제공합니다.
#
# 같은 origin 으로 묶으면 브라우저 CORS preflight 가 없어지고, CSRF 쿠키를
# 프론트엔드 JavaScript 가 읽을 수 있습니다. 백엔드는 다른 호스트에 두면
# host-only 쿠키라 document.cookie 로 접근할 수 없습니다.
#
# BACKEND_UPSTREAM 과 NGINX_RESOLVER 는 컨테이너 기동 시 envsubst 로 치환합니다.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 외부에서 TLS 를 종단하면 이 Nginx 에는 평문 http 로 들어옵니다. 그래서 $scheme 은
# http 입니다. 앞단이 이미 넣어 준 X-Forwarded-Proto 를 $scheme 으로 덮으면 백엔드가
# 자기를 http 로 인식해, 절대 URI 를 만드는 경로마다 https 가 사라집니다.
#
# 들어온 값이 있으면 그것을 쓰고, 없을 때만 $scheme 을 씁니다. 앞단이 없는 환경에서도
# 그대로 동작합니다.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ''      $host;
}

server {
    listen 8080;
    server_name _;

    # proxy_pass 에 호스트명을 직접 쓰면 Nginx 가 기동 시점에 한 번만 DNS 를
    # 조회하고 그 주소를 계속 씁니다. 백엔드 컨테이너나 ECS task 를 새로 만들면
    # 주소가 바뀌는데 Nginx 는 옛 주소로 보내 502 가 이어집니다.
    #
    # 아래 resolver 와 변수 형태의 proxy_pass 를 함께 쓰면 요청 시점에 다시
    # 조회합니다. valid 로 짧게 캐시해 매 요청 조회를 피합니다.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # 변수를 쓰면 Nginx 가 location 접두사를 대신 붙여주지 않으므로 원본 URI 를
    # 직접 이어 붙입니다. BACKEND_UPSTREAM 은 끝에 / 를 두지 않습니다.
    set $backend_upstream ${BACKEND_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # 컨테이너 상태 확인용입니다. 백엔드에 의존하지 않고 응답해야 하므로
    # 프록시보다 먼저 선언합니다.
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;

        # SSE 는 응답을 버퍼링하면 이벤트가 즉시 전달되지 않습니다.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # OAuth Provider 가 인가 코드를 들고 돌아오는 경로입니다. Spring Security 의
    # 콜백 엔드포인트이므로 백엔드가 받아야 합니다.
    #
    # 이 블록이 없으면 아래 location / 의 SPA fallback 으로 떨어져 index.html 이
    # 반환됩니다. 화면은 뜨지만 로그인은 끝나지 않고, 원인은 브라우저 주소창만
    # 봐서는 드러나지 않습니다.
    location /login/oauth2/code/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;
    }

    location /oauth2/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;
    }

    # SockJS 는 WebSocket 외에 XHR polling 등으로 fallback 하므로 /ws 하위
    # 경로 전체를 넘깁니다. Upgrade 헤더는 WebSocket transport 에서만 채워집니다.
    location /ws {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;

        # STOMP heartbeat 는 4초 간격입니다. 기본 60초 타임아웃이면 유휴
        # 연결이 끊기므로 넉넉히 둡니다.
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # 해시가 붙은 자산은 내용이 바뀌면 파일명이 바뀌므로 길게 캐시합니다.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 는 클라이언트 라우팅을 쓰므로, 존재하지 않는 경로는 index.html 로
    # 넘겨 새로고침과 직접 진입이 동작하게 합니다.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html 을 캐시하면 새 배포 후에도 옛 자산 해시를 계속 참조합니다.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
