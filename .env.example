# 백엔드 주소
#
# REST, WebSocket, SSE, OAuth2 인가 요청이 모두 이 값을 씁니다.
# 비워 두면 같은 origin 의 상대 경로로 요청하며, 개발에서는 vite.config.ts 의
# 프록시가 /api, /ws, /oauth2 를 localhost:8080 으로 넘깁니다.
# 비워 두는 쪽을 권합니다. 프록시를 거치면 개발에서 CORS 설정이 필요 없습니다.
#
# 개발:             (비워 둠)  또는  http://localhost:8080
# 같은 origin 배포:  (비워 둠 — Nginx 가 /api, /ws 를 앱으로 프록시)
# 경로 접두사 배포:   /sb/mopl
# 다른 호스트 배포:   https://api.example.com
VITE_API_BASE_URL=

# 앱 자신의 base path
#
# 앱을 서브 경로에 배포할 때만 채웁니다. vite.config.ts 의 base 와 정적 자산
# URL 접두사가 이 값을 따릅니다. 백엔드 주소와는 무관합니다.
#
# 루트 배포:        (비워 둠)
# 서브 경로 배포:    /sb/mopl
VITE_PUBLIC_PATH=

# 배포 시 백엔드에도 함께 설정해야 하는 값
#
# prod 프로파일은 아래 두 값을 필수로 요구하며, 없으면 기동에 실패합니다.
# FE 배포 origin 을 그대로 넣습니다.
#
#   CORS_ALLOWED_ORIGINS=https://mopl.example.com
#   WS_ALLOWED_ORIGINS=https://mopl.example.com
